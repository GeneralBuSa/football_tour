SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
PORT=8000
PASSWORD_RESET_BASE_URL=http://localhost:3000
MAIL_FROM=FT26 <noreply@example.com>
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# production: HSTS başlığını açar ve şifre sıfırlamada dev token dönmesini engeller
NODE_ENV=development
# Render/Nginx gibi reverse proxy arkasında gerçek istemci IP'si için (rate limit) 1 yapın
TRUST_PROXY=
# SADECE yerel geliştirme: e-posta servisi yokken şifre sıfırlama token'ını API yanıtında döndürür.
# Yayındaki sunucuda asla 1 yapmayın.
ALLOW_DEV_RESET_TOKEN=
